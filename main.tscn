[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/world.gd" id="1_world"]
[ext_resource type="Script" path="res://scripts/player.gd" id="2_player"]
[ext_resource type="Script" path="res://scripts/hud.gd" id="3_hud"]

[node name="World" type="Node2D"]
script = ExtResource("1_world")

[node name="Player" type="Node2D" parent="."]
visible = false
script = ExtResource("2_player")

[node name="Camera2D" type="Camera2D" parent="Player"]
position_smoothing_enabled = true
position_smoothing_speed = 8.0

[node name="HUD" type="CanvasLayer" parent="."]
script = ExtResource("3_hud")

[node name="Info" type="Label" parent="HUD"]
offset_left = 16.0
offset_top = 12.0
offset_right = 420.0
offset_bottom = 150.0
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6

[node name="Controls" type="Label" parent="HUD"]
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = -38.0
offset_right = 1100.0
offset_bottom = -12.0
grow_vertical = 0
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
text = "WASD / Arrows: move     Q: use medkit     Space: use ammo     Mouse wheel or +/-: zoom     R: restart     Esc: menu"

[node name="Menu" type="CenterContainer" parent="HUD"]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="HUD/Menu"]
custom_minimum_size = Vector2(400, 0)

[node name="Margin" type="MarginContainer" parent="HUD/Menu/Panel"]
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="Box" type="VBoxContainer" parent="HUD/Menu/Panel/Margin"]
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="HUD/Menu/Panel/Margin/Box"]
unique_name_in_owner = true
theme_override_font_sizes/font_size = 22
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="HUD/Menu/Panel/Margin/Box"]
text = "Choose a scenario:"
horizontal_alignment = 1

[node name="Buttons" type="VBoxContainer" parent="HUD/Menu/Panel/Margin/Box"]
unique_name_in_owner = true
